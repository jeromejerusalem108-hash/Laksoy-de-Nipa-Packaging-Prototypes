<script src="https://cdn.jsdelivr.net/npm/three@0.147.0/examples/js/controls/OrbitControls.js"></script>
<script>
const ASSETS={"front": "data:image/webp;base64,", "left": "data:image/webp;base64,", "back": "data:image/webp;base64,", "base": "data:image/webp;base64,", "lid": "data:image/webp;base64,", "label": "data:image/webp;base64,", "collar": "data:image/webp;base64,"};
const LIDH={"logo": [0.1164, 0.104, 0.8871, 0.896], "name": [0.338, 0.49, 0.688, 0.79], "gold": [[0.0233, 0.04, 0.158, 0.24], [0.838, 0.04, 0.9767, 0.24], [0.0233, 0.77, 0.158, 0.96], [0.838, 0.77, 0.9767, 0.96]]};
(function(){
if(!window.THREE||!THREE.OrbitControls){document.getElementById('msg').style.display='grid';return}
const $=id=>document.getElementById(id);
const loadImg=src=>new Promise(r=>{const i=new Image();i.onload=()=>r(i);i.onerror=()=>r(null);i.src=src});
Promise.all(Object.keys(ASSETS).map(k=>loadImg(ASSETS[k]).then(i=>[k,i]))).then(a=>{const o={};a.forEach(([k,i])=>o[k]=i);
 Promise.race([document.fonts.load('700 20px Oswald'),new Promise(r=>setTimeout(r,1500))]).then(()=>init(o),()=>init(o))});

function init(IMG){
/* ---------- constants (1 unit = 1 inch) ---------- */
const T=.12, L=4-2*T, HW=12-T, FW=.75, BW=3.74, FDEP=3.74, FOFF=FDEP-T, BOT_HOVER=12.6;
const isDark=()=>{const d=document.documentElement.dataset.theme;return d?d==='dark':matchMedia('(prefers-color-scheme: dark)').matches};

/* ---------- renderer ---------- */
const renderer=new THREE.WebGLRenderer({antialias:true});
renderer.setPixelRatio(Math.min(devicePixelRatio,2));
renderer.outputEncoding=THREE.sRGBEncoding;renderer.toneMapping=THREE.ACESFilmicToneMapping;renderer.toneMappingExposure=1.0;
renderer.shadowMap.enabled=true;renderer.shadowMap.type=THREE.PCFSoftShadowMap;
const stage=$('stage');stage.appendChild(renderer.domElement);const dom=renderer.domElement;
const scene=new THREE.Scene();
const camera=new THREE.PerspectiveCamera(30,1,1,500);
const controls=new THREE.OrbitControls(camera,dom);
controls.enableDamping=true;controls.enablePan=true;controls.minDistance=6;controls.maxDistance=200;
let dirty=true;const inv=()=>{dirty=true};
controls.addEventListener('change',inv);

function cv(w,h,fn,srgb=true){const c=document.createElement('canvas');c.width=w;c.height=h;fn(c.getContext('2d'),w,h);const t=new THREE.CanvasTexture(c);t.anisotropy=8;if(srgb)t.encoding=THREE.sRGBEncoding;return t}
const grain=(w,h,n,a)=>cv(w,h,(g,W,H)=>{g.fillStyle='#808080';g.fillRect(0,0,W,H);for(let i=0;i<n;i++){const v=Math.random()*255|0;g.fillStyle=`rgba(${v},${v},${v},${a})`;g.fillRect(Math.random()*W,Math.random()*H,1+Math.random()*2,1)}},false);
const tex=(img,mirror)=>{const t=new THREE.Texture(img);t.encoding=THREE.sRGBEncoding;t.anisotropy=8;if(mirror)t.wrapS=THREE.MirroredRepeatWrapping;t.needsUpdate=true;return t};

function setBackground(){const dk=isDark();
 scene.background=cv(2,256,(g,w,h)=>{const r=g.createLinearGradient(0,0,0,h);if(dk){r.addColorStop(0,'#2d241c');r.addColorStop(1,'#14100c')}else{r.addColorStop(0,'#f4efe6');r.addColorStop(1,'#cfc3ae')}g.fillStyle=r;g.fillRect(0,0,w,h)});inv()}
setBackground();
matchMedia('(prefers-color-scheme: dark)').addEventListener('change',setBackground);
new MutationObserver(setBackground).observe(document.documentElement,{attributes:true,attributeFilter:['data-theme']});

/* studio reflections */
const envS=new THREE.Scene();
envS.add(new THREE.Mesh(new THREE.SphereGeometry(20,32,16),new THREE.MeshBasicMaterial({side:THREE.BackSide,map:cv(2,256,(g,w,h)=>{const r=g.createLinearGradient(0,0,0,h);r.addColorStop(0,'#fff');r.addColorStop(.5,'#cfc9bd');r.addColorStop(1,'#6e6454');g.fillStyle=r;g.fillRect(0,0,w,h)})})));
[[8,6,7,5,4],[-9,5,-3,3,6],[0,13,0,8,2],[-7,4,8,2,5]].forEach(p=>{const b=new THREE.Mesh(new THREE.BoxGeometry(p[3],p[4],.3),new THREE.MeshBasicMaterial());b.material.color.setScalar(9);b.position.set(p[0],p[1],p[2]);b.lookAt(0,0,0);envS.add(b)});
scene.environment=new THREE.PMREMGenerator(renderer).fromScene(envS,.02).texture;
scene.add(new THREE.HemisphereLight(0xffffff,0xb9a98f,.3));
const dl=new THREE.DirectionalLight(0xfff4e6,1.3);dl.position.set(10,30,22);dl.target.position.set(2,0,0);scene.add(dl.target);
dl.castShadow=true;dl.shadow.mapSize.set(2048,2048);
Object.assign(dl.shadow.camera,{left:-30,right:30,top:30,bottom:-30,near:5,far:100});dl.shadow.bias=-.0005;dl.shadow.normalBias=.03;scene.add(dl);
const floor=new THREE.Mesh(new THREE.PlaneGeometry(300,300),new THREE.ShadowMaterial({opacity:.3}));floor.rotation.x=-Math.PI/2;floor.position.y=-.01;floor.receiveShadow=true;scene.add(floor);

/* ---------- materials ---------- */
const paperBump=grain(512,1024,9000,.5);
const boardBump=grain(256,256,5000,.6);
const printMat=t=>new THREE.MeshStandardMaterial({map:t,roughness:.58,bumpMap:paperBump,bumpScale:.3});
/* corrugated cardboard: the cut edges show the wavy flute between two liners */
const fluteT=cv(128,64,(g,W,H)=>{g.fillStyle='#5e4224';g.fillRect(0,0,W,H);
 g.fillStyle='#d6b27a';g.fillRect(0,0,W,12);g.fillRect(0,H-12,W,12);
 g.strokeStyle='#b88a4e';g.lineWidth=7;g.beginPath();
 for(let x=0;x<=W;x++){const y=H/2+Math.sin(x/W*Math.PI*4)*(H/2-18);x?g.lineTo(x,y):g.moveTo(x,y)}g.stroke()});
fluteT.wrapS=fluteT.wrapT=THREE.RepeatWrapping;
const FPITCH=.5;
function edgeUV(g,w,h){const uv=g.attributes.uv;for(let i=0;i<16;i++){const u=uv.getX(i),v=uv.getY(i);if(i<8)uv.setXY(i,v*h/FPITCH,u);else uv.setXY(i,u*w/FPITCH,v)}}
const boardM=new THREE.MeshStandardMaterial({map:fluteT,roughness:.92});
const liningM=new THREE.MeshStandardMaterial({color:0xf7f4ec,roughness:.85,bumpMap:boardBump,bumpScale:.25});
const flapOuter=new THREE.MeshStandardMaterial({color:0xefe0bb,roughness:.7});
const T_={front:tex(IMG.front),left:tex(IMG.left),back:tex(IMG.back),lid:tex(IMG.lid),base:tex(IMG.base)};
const PM={};Object.keys(T_).forEach(k=>PM[k]=printMat(T_[k]));
/* clean polished gold: smooth banded gradient (seamless around the cap) + fine brushed lines, fully metallic, low roughness */
const goldT=cv(256,256,(g,W,H)=>{const r=g.createLinearGradient(0,0,W,0);[[0,'#b8862a'],[.16,'#f0cc6c'],[.30,'#d9a22b'],[.48,'#fff1bd'],[.64,'#c89426'],[.82,'#f3d27a'],[1,'#b8862a']].forEach(([o,c])=>r.addColorStop(o,c));g.fillStyle=r;g.fillRect(0,0,W,H);
 for(let y=0;y<H;y+=2){g.fillStyle='rgba(255,255,255,'+(.025+.03*(((y*7)%5)/5))+')';g.fillRect(0,y,W,1)}});
const goldM=new THREE.MeshStandardMaterial({map:goldT,color:0xffffff,metalness:1,roughness:.2,envMapIntensity:1.7});

/* ---------- parts registry (notes are DRAFTS) ---------- */
const P={};
const def=(id,g,name,material,what,why)=>{P[id]={id,g,name,material,what,why,meshes:[],slots:[]}};
const PW='Printed on 157gsm wrapping paper';
def('logo','Printed artwork','Brand logo',PW+' (lid); printed label paper (bottle)','Round emblem: a nipa frond and fruit cluster inside a twisted-rope ring, with the name set inside.','One mark that repeats on the lid and the bottle label, so the pack is recognised from above and from the front. The nipa frond points to the palm the spirit is made from.');
def('name','Printed artwork','Product name: Laksoy de Nipa',PW+' (Left wall, lid); label paper (bottle)','The wordmark in dark green on cream. Stacked vertically down the Left wall, and set inside the emblem on the lid and label.','Vertical lettering fills the tall, narrow side wall and reads from the end of a shelf. Dark green on cream stays legible and echoes the nipa leaf.');
def('slogan','Printed artwork','Product Type','Printed bottle label paper','Two-line tagline under the name on the bottle label. Your slide calls it Product Type.','Says plainly what the product is and where it comes from, in a smaller size so the name is still read first.');
def('description','Printed artwork','Product description',PW+' (Back wall)','Short paragraph on the Back wall: laksoy is distilled from fermented nipa palm sap; the concept draws on documented production in Gigaquit, Surigao del Norte; it is a student proposal, not an endorsement by any producer or community.','Gives the origin story where a buyer turns the box over, and states that this is a design concept, so the pack is honest about who made it.');
def('leaf','Printed artwork','Nipa leaf motif','Gold-toned print on 157gsm wrapping paper','Gold nipa fronds along the edges of the Left wall and one large frond on the Back wall. The logo carries a green frond.','Nipa palm is the sap source, so the plant appears on more than one side. Gold on cream stays quiet next to the dark green name.');
def('weave','Printed artwork','Abaca weave pattern','Printed pattern on 157gsm wrapping paper (not real woven fibre)','Basket-weave band across the foot of every wall and on the underside of the base.','Its purpose is to represent traditional Filipino craftsmanship and Philippine cultural heritage, particularly the country\'s traditional weaving practices.');
def('twine','Printed artwork','Jute twine band','Printed pattern on 157gsm wrapping paper','Twisted rope bands between the plain wall and the weave.','Separates the woven base from the artwork above it and repeats the rope ring in the logo.');
def('gold','Printed artwork','Gold accents','Gold-coloured print; foil or metallic ink is not specified in the brief','Window frames, corner flourishes, the lid border, the label border and the fan ornament.','Its purpose is to give the packaging a luxurious, elegant, and sophisticated appearance.');
def('board','Materials','Corrugated cardboard 350gsm','Corrugated cardboard, 350gsm','Core of the four walls, the lid and the base: a wavy flute layer between two flat liners. It shows as the fluted edge at the window cut-outs, the rim and the open ends.','Light but stiff enough to keep a 4 × 4 × 12 in box square around a 10 in glass bottle, and a flat surface for the wrapping paper to be pasted onto.');
def('paper','Materials','Wrapping paper 157gsm','Wrapping paper, 157gsm, printed','Printed outer skin pasted over the corrugated cardboard. It carries all of the artwork.','Light enough to wrap tightly over edges and corners, smooth enough to hold the print.');
def('lining','Materials','White wrapping paper lining','Plain white wrapping paper','Lines the back of the corrugated cardboard: the inside faces of the walls, lid and base. Seen through the windows and when the lid is open.','Finishes the inside so no raw cardboard shows. A clean white backdrop makes the clear glass and label stand out through the windows.');
def('cork','Materials','Golden cork lid','Cork stopper with gold finish','The bottle stopper, finished in gold. Your slide 4 calls it Golden Cork Lid.','Cork is the traditional natural stopper for a spirit bottle. The gold finish ties it to the gold accents on the box.');
def('glass','Bottle','Glass bottle','Clear glass, 10 in tall × 3.5 in wide','Straight-sided bottle with a rounded shoulder and a short neck.','Clear glass shows the spirit and lets the label be the main graphic. The 10 in height sets the box: it leaves room for the base and the lid in a 12 in box.');
def('label','Bottle','Bottle label','Printed label paper (stock not specified)','Cream label with a gold border that carries the logo, name and slogan.','Puts the brand on the product itself, so it still reads once the box is gone.');
def('collar','Bottle','Woven neck collar','Woven band (fibre not specified)','Basket-weave band around the neck, under the stopper.','Repeats the box weave at bottle scale and covers the join between neck and stopper.');
def('lid','Box','Lid','Corrugated cardboard 350gsm, 157gsm wrapping paper outside, white lining inside','Square 4 × 4 in top that carries the logo. It is hinged at the top edge of the back wall and swings open and shut like a normal box lid.','Closes the box and puts the logo on the one face seen from above. Being attached to the back wall, it cannot get lost.');
def('base','Box','Base','Corrugated cardboard 350gsm, weave print underneath, white lining on top','Square floor hinged to the bottom edge of the back wall and folded in under the bottle. The bottle stands on it.','Closes the bottom and carries the bottle weight. Part of the same flat dieline as the walls and lid.');
def('walls','Box','Walls (Front, Left, Back, Right)','Corrugated cardboard 350gsm, 157gsm wrapping paper outside, white lining inside','Four 12 in tall panels that fold from one flat strip with one glued seam. The lid and the base are attached to the Back wall. Front and Right have window cut-outs.','One strip folds into all four sides. The windows let a buyer see the bottle and label before opening.');
const GROUPS=['Printed artwork','Materials','Bottle','Box'];

const pick=[];            // raycast targets
const bottleMeshes=[];
function reg(id,mesh,slot){const p=P[id];if(slot===undefined)p.meshes.push(mesh);else p.slots.push([mesh,slot])}
const hidMat=new THREE.MeshBasicMaterial({visible:false});
const hlMat=new THREE.MeshBasicMaterial({color:0xffc233,transparent:true,opacity:.45,depthWrite:false,polygonOffset:true,polygonOffsetFactor:-3,polygonOffsetUnits:-3,side:THREE.DoubleSide});
const edgeMat=new THREE.LineBasicMaterial({color:0xffe08a});
function hotMesh(parent,id,geo,x,y,z,ry,layer,noPick){
 const m=new THREE.Mesh(geo,hidMat);m.position.set(x,y,z);if(ry)m.rotation.y=ry;m.userData.part=id;m.userData.hot=1;
 const e=new THREE.LineSegments(new THREE.EdgesGeometry(geo),edgeMat);e.visible=false;e.raycast=()=>{};m.add(e);m.userData.edge=e;
 m.renderOrder=3+(layer||0);parent.add(m);reg(id,m);if(!noPick)pick.push(m);return m}
/* rect in panel-fraction coords, panel occupies x in [ox,ox+w], y in [oy,oy+h] */
function hotRect(parent,id,r,ox,oy,w,h,layer,noPick){
 const gw=(r[2]-r[0])*w,gh=(r[3]-r[1])*h;
 return hotMesh(parent,id,new THREE.PlaneGeometry(gw,gh),ox+(r[0]+r[2])/2*w,oy+h-(r[1]+r[3])/2*h,.004+.0015*(layer||0),0,layer,noPick)}
const R=(W,H,x0,y0,x1,y1)=>[x0/W,y0/H,x1/W,y1/H];

/* slab: outer face +z at z=0, thickness runs to -T. uvr=[u0,u1,v0,v1] of the printed texture */
function slab(parent,w,h,t,cx,cy,uvr,printM,o,loc){
 const g=new THREE.BoxGeometry(w,h,t),uv=g.attributes.uv,pos=g.attributes.position;edgeUV(g,w,h);
 const face=(s,fn)=>{for(let i=s;i<s+4;i++){const [u,v]=fn(pos.getX(i)/w+.5,pos.getY(i)/h+.5);uv.setXY(i,u,v)}};
 face(16,(x,y)=>[uvr[0]+x*(uvr[1]-uvr[0]),uvr[2]+y*(uvr[3]-uvr[2])]);
 const mats=[boardM,boardM,boardM,boardM,printM,liningM],ids=['board','board','board','board','paper','lining'];
 if(o&&o.edgeR){mats[0]=printM;ids[0]='paper';face(0,(x,y)=>[.998,uvr[2]+y*(uvr[3]-uvr[2])])}
 if(o&&o.edgeL){mats[1]=printM;ids[1]='paper';face(4,(x,y)=>[.002,uvr[2]+y*(uvr[3]-uvr[2])])}
 const m=new THREE.Mesh(g,mats);m.position.set(cx,cy,-t/2);m.castShadow=m.receiveShadow=true;
 m.userData.slotParts=ids;m.userData.loc=loc;
 ids.forEach((id,i)=>reg(id,m,i));parent.add(m);pick.push(m);return m}

/* wall panel with optional window, x0 = left edge in parent coords */
const WIN={u0:52/458,u1:410/458,v0:44/1078,v1:884/1078};
function hots(parent,key,x0,w,oy,h){const H=HOTS[key];H.forEach(([id,r,layer])=>hotRect(parent,id,r,x0,oy,w,h,layer))}
const FR=[1,1];
const HOTS={
 front:[['gold',R(458,1078,0,0,52,916),0],['gold',R(458,1078,410,0,458,916),0],['gold',R(458,1078,52,0,410,44),0],['gold',R(458,1078,52,884,410,916),0],['twine',R(458,1078,0,918,458,985),0],['weave',R(458,1078,0,985,458,1078),0]],
 left:[['leaf',R(302,1084,4,10,60,880),0],['leaf',R(302,1084,242,10,298,880),0],['name',R(302,1084,95,85,215,735),1],['gold',R(302,1084,78,760,232,890),1],['twine',R(302,1084,0,912,302,985),0],['weave',R(302,1084,0,985,302,1084),0]],
 back:[['leaf',R(446,1078,40,630,425,895),0],['description',R(446,1078,55,120,395,620),1],['gold',R(446,1078,20,10,90,75),1],['gold',R(446,1078,355,10,430,75),1],['gold',R(446,1078,28,862,60,895),1],['gold',R(446,1078,385,862,425,895),1],['twine',R(446,1078,0,905,446,985),0],['weave',R(446,1078,0,985,446,1078),0]]};
HOTS.right=HOTS.front;
function panel(name,x0,w,key,win,ends){
 const g=new THREE.Group();g.userData.name=name;const pm=PM[key===('right')?'front':key];
 const add=(xa,xb,ya,yb)=>slab(g,xb-xa,yb-ya,T,x0+(xa+xb)/2,(ya+yb)/2,[xa/w,xb/w,ya/HW,yb/HW],pm,{edgeL:ends&&xa===0,edgeR:ends&&xb===w},name);
 if(!win)add(0,w,0,HW);else{
  const a=WIN.u0*w,b=WIN.u1*w,y0=HW*(1-WIN.v1),y1=HW*(1-WIN.v0);
  add(0,w,0,y0);add(0,w,y1,HW);add(0,a,y0,y1);add(b,w,y0,y1)}
 hots(g,key,x0,w,0,HW);return g}

/* ---------- the wall strip (net) ---------- */
const rig=new THREE.Group();scene.add(rig);   // tilts the dieline between lying on the ground and standing
const net=new THREE.Group();rig.add(net);
const front=panel('Front wall',-2,4,'front',true,true);net.add(front);
const P1=new THREE.Group();P1.position.x=2;net.add(P1);
const left=panel('Left wall',T,L,'left',false,false);P1.add(left);
const P2=new THREE.Group();P2.position.x=2*T+L;P1.add(P2);
const back=panel('Back wall',0,4,'back',false,true);P2.add(back);
const P3=new THREE.Group();P3.position.x=4;P2.add(P3);
const right=panel('Right wall',T,L,'right',true,false);P3.add(right);
// glue flap
const flapP=new THREE.Group();flapP.position.x=-2;net.add(flapP);
{const fg=new THREE.BoxGeometry(FW,HW,.05);edgeUV(fg,FW,HW);const m=new THREE.Mesh(fg,[boardM,boardM,boardM,boardM,flapOuter,liningM]);m.position.set(-FW/2,HW/2,-.025);m.castShadow=m.receiveShadow=true;
 m.userData.slotParts=['board','board','board','board','paper','lining'];m.userData.loc='Glue flap';m.userData.slotParts.forEach((id,i)=>reg(id,m,i));flapP.add(m);pick.push(m)}
// window highlight planes (list only, not pickable)
[[front,-2,4],[right,T,L]].forEach(([g,x0,w])=>hotRect(g,'walls',[WIN.u0,WIN.v0,WIN.u1,WIN.v1],x0,0,w,HW,2,true));
{const all=[];[front,left,back,right].forEach(g=>g.children.forEach(c=>{if(c.userData.slotParts)all.push(c)}));all.forEach(m=>reg('walls',m))}
// whole-mesh highlight for 'walls' uses the same overlay routine

/* ---------- lid and base: part of the dieline, hinged to the Back wall ---------- */
const flipR=r=>[1-r[2],1-r[3],1-r[0],1-r[1]];   // lid art is printed turned 180 deg so it reads upright once folded over
const lidH=new THREE.Group();lidH.position.set(2,HW,-T);P2.add(lidH);      // hinge line = top edge of the Back wall
const lidIn=new THREE.Group();lidIn.position.z=T+.003;lidH.add(lidIn);
{slab(lidIn,4,4,T,0,2-T,[1,0,1,0],PM.lid,{},'Lid');
 const l=LIDH,oy=-T;hotRect(lidIn,'logo',flipR(l.logo),-2,oy,4,4,0);hotRect(lidIn,'name',flipR(l.name),-2,oy,4,4,1);l.gold.forEach(r=>hotRect(lidIn,'gold',flipR(r),-2,oy,4,4,1));
 lidIn.children.filter(c=>c.userData.slotParts).forEach(m=>reg('lid',m))}
const baseH=new THREE.Group();baseH.position.set(2,T,-T);P2.add(baseH);   // hinge line = bottom edge of the Back wall
const baseIn=new THREE.Group();baseIn.position.z=T+.003;baseH.add(baseIn);
{slab(baseIn,BW,FDEP,T,0,-FDEP/2,[0,1,0,1],PM.base,{},'Base');hotRect(baseIn,'weave',[0,0,1,1],-BW/2,-FDEP,BW,FDEP,0);
 baseIn.children.filter(c=>c.userData.slotParts).forEach(m=>reg('base',m))}

/* ---------- bottle ---------- */
const bottle=new THREE.Group();scene.add(bottle);
const spin=new THREE.Group();bottle.add(spin);
const bm=(m,id,hot)=>{m.castShadow=!hot;m.receiveShadow=!hot;m.userData.part=id;reg(id,m);pick.push(m);bottleMeshes.push(m);spin.add(m);return m};
const outerP=[[0,0],[1.3,0],[1.62,.2],[1.75,.62],[1.75,6.25],[1.62,6.85],[1.2,7.3],[.85,7.62],[.7,7.95],[.7,9.25]];
const innerP=[[.56,9.25],[.56,7.98],[.72,7.7],[1.08,7.38],[1.5,6.9],[1.62,6.3],[1.62,.62],[1.5,.3],[1.2,.2],[0,.2]];
const glass=bm(new THREE.Mesh(new THREE.LatheGeometry(outerP.concat(innerP).map(p=>new THREE.Vector2(p[0],p[1])),72),new THREE.MeshPhysicalMaterial({color:0xffffff,roughness:0,transmission:1,thickness:.6,ior:1.5,envMapIntensity:1.5,attenuationColor:new THREE.Color(0xcfeee6),attenuationDistance:8,side:THREE.DoubleSide})),'glass',true);
glass.castShadow=false;
const collarT=tex(IMG.collar,true);collarT.repeat.set(2,1);collarT.wrapS=THREE.MirroredRepeatWrapping;
bm(new THREE.Mesh(new THREE.CylinderGeometry(.8,.8,1.2,48),new THREE.MeshStandardMaterial({map:collarT,roughness:.8})),'collar').position.y=8.64;
const cap=bm(new THREE.Mesh(new THREE.CylinderGeometry(.82,.82,.74,48),goldM),'cork');cap.position.y=9.63;
// label: wraps the body, undistorted aspect 306:490
const LR=1.78,LA=3.2,LH=LA/(306/490),LPHI=LA/LR,LY=3.5;
const labelT=tex(IMG.label);
const lab=new THREE.Mesh(new THREE.CylinderGeometry(LR,LR,LH,64,1,true,-LPHI/2,LPHI),new THREE.MeshStandardMaterial({map:labelT,transparent:true,alphaTest:.5,roughness:.5,side:THREE.DoubleSide}));
lab.position.y=LY;bm(lab,'label');
function labelHot(id,r){const t0=-LPHI/2+r[0]*LPHI,tl=(r[2]-r[0])*LPHI,hh=(r[3]-r[1])*LH;
 const m=hotMesh(spin,id,new THREE.CylinderGeometry(LR+.012,LR+.012,hh,24,1,true,t0,tl),0,LY+LH/2-(r[1]+r[3])/2*LH,0,0,2);m.material=hidMat;bottleMeshes.push(m)}
labelHot('logo',[.04,.067,.948,.71]);labelHot('name',[.196,.363,.824,.639]);labelHot('slogan',[.212,.735,.824,.849]);labelHot('gold',[.294,.869,.725,1]);
// put bottle at rest on ground
let spinVel=0;

/* ---------- highlight ---------- */
function ov(m){let o=m.userData.ov;if(!o){const mats=Array.isArray(m.material)?m.material.map(()=>hidMat):hidMat;o=new THREE.Mesh(m.geometry,mats);o.renderOrder=4;o.raycast=()=>{};m.add(o);m.userData.ov=o}return o}
function setHL(id,on){const p=P[id];if(!p)return;
 p.meshes.forEach(m=>{if(m.userData.hot){m.material=on?hlMat:hidMat;m.userData.edge.visible=on}else if(Array.isArray(m.material)){const o=ov(m);o.material=on?m.material.map(()=>hlMat):m.material.map(()=>hidMat)}else{ov(m).material=on?hlMat:hidMat}});
 p.slots.forEach(([m,i])=>{const o=ov(m);o.material[i]=on?hlMat:hidMat});inv()}

/* ---------- animation pose ---------- */
const clamp=(x,a=0,b=1)=>Math.min(b,Math.max(a,x));
const seg=(p,a,b)=>clamp((p-a)/(b-a));
const ease=x=>x*x*(3-2*x);
const lerp=(a,b,t)=>a+(b-a)*t;
const FLATX=-5.565,RZ=9.69,OPEN=105*Math.PI/180;
const BOT0=[11.5,2];
let p=1;
function pose(v){p=clamp(v);
  // 0-.10 dieline stands up off the ground | .10-.38 walls fold | .38-.46 base folds in | .46-.54 box set down
  // .50-.56 lid swings wide | .60-.80 bottle goes in | .84-1 lid swings shut
  const u=ease(seg(p,0,.10)),f1=ease(seg(p,.10,.20)),f2=ease(seg(p,.17,.27)),f3=ease(seg(p,.24,.34)),fl=ease(seg(p,.31,.38)),g=ease(seg(p,.10,.38));
  const h=ease(seg(p,.38,.46)),dn=ease(seg(p,.46,.54));
  rig.rotation.x=-Math.PI/2*(1-u);rig.position.set(0,T*(1-u),lerp(RZ,2,g));
  net.position.set(FLATX*(1-g),FOFF*(1-dn),0);
  P1.rotation.y=f1*Math.PI/2;P2.rotation.y=f2*Math.PI/2;P3.rotation.y=f3*Math.PI/2;
  flapP.rotation.y=-fl*Math.PI/2;flapP.position.x=-2+.03*fl;
  baseH.rotation.x=h*Math.PI/2;
  {const o=ease(seg(p,.50,.56)),c=ease(seg(p,.84,1));lidH.rotation.x=(Math.PI/2+o*(OPEN-Math.PI/2))*(1-c)-Math.PI/2}
  // bottle
  {const a=ease(seg(p,.6,.66)),b=ease(seg(p,.66,.72)),c=ease(seg(p,.72,.8));
   const y=p<.72?lerp(0,BOT_HOVER,a):lerp(BOT_HOVER,T,c);
   bottle.position.set(BOT0[0]*(1-b),y,BOT0[1]*(1-b))}
  inv();syncUI()}

/* ---------- camera ---------- */
const DIRS={Front:[0,.25,1],Left:[1,.25,0],Right:[-1,.25,0],Back:[0,.25,-1],Top:[.001,1,.001],'3/4':[.55,.42,.72],Above:[.12,1,.42]};
let mode='explore',goal=null;
const bounds=()=>mode==='explore'?{cx:0,cy:6,w:5,h:14}:{cx:2.5,cy:11,w:24,h:24};
function fitDist(b){const t=Math.tan(camera.fov*Math.PI/360);return Math.max(b.h/2/t,b.w/2/(t*camera.aspect))*1.12}
function flyTo(name){const b=bounds(),tg=new THREE.Vector3(b.cx,b.cy,0),d=fitDist(b);
 goal={pos:tg.clone().add(new THREE.Vector3(...DIRS[name]).normalize().multiplyScalar(d)),tg};inv()}
const resize=()=>{renderer.setSize(innerWidth,innerHeight);camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();inv()};
addEventListener('resize',resize);resize();
{const b=bounds(),d=fitDist(b);controls.target.set(b.cx,b.cy,0);camera.position.set(b.cx,b.cy,0).add(new THREE.Vector3(...DIRS['3/4']).normalize().multiplyScalar(d))}
dom.addEventListener('pointerdown',()=>{goal=null});
dom.addEventListener('wheel',()=>{goal=null},{passive:true});

/* ---------- UI ---------- */
const views=$('views');
Object.keys(DIRS).forEach(k=>{const b=document.createElement('button');b.textContent=k==='3/4'?'3/4 view':k;b.onclick=()=>flyTo(k);views.appendChild(b)});
const spinB=document.createElement('button');spinB.textContent='Auto-rotate';spinB.setAttribute('aria-pressed','false');
spinB.onclick=()=>{controls.autoRotate=!controls.autoRotate;controls.autoRotateSpeed=2.5;spinB.setAttribute('aria-pressed',String(controls.autoRotate));inv()};views.appendChild(spinB);

const STOPS=[1,.82,.58,.36,0],STEPN=['','Lid open','Bottle on ground','Base folded out','Flat dieline'];
function stageName(){const q=p;
 if(mode==='open'){return q>=.999?'Box closed':q>.84?'Swinging the lid open':q>.8?'Lid open':q>.6?'Lifting the bottle out':q>.54?'Bottle on the ground':q>.46?'Lifting the box up':q>.38?'Folding the base out':q>.1?'Unfolding the walls':q>.02?'Laying the dieline down':'Flat dieline'}
 return q<.02?'Flat dieline on the ground':q<.10?'Standing the dieline up':q<.38?'Folding the walls':q<.46?'Folding the base in':q<.54?'Setting the box down':q<.6?'Swinging the lid wide':q<.8?'Lowering the bottle in':q<.84?'Bottle in':q<.999?'Swinging the lid shut':'Box closed'}
const sl=$('sl'),act=$('act'),sname=$('stageName');
function syncUI(){if(mode==='explore')return;sl.value=Math.round((mode==='open'?1-p:p)*1000);sname.textContent=stageName();
 if(mode==='build')act.textContent=playing?'Pause':'Play';else act.textContent=p<.01?'Step: Close the box':'Step: '+STEPN[stepIdx()]}
function stepIdx(){for(let i=0;i<STOPS.length;i++){if(STOPS[i]<p-.01)return i}return STOPS.length-1}
let tw=null,playing=false;
function tweenTo(to,dur){tw={from:p,to,t0:performance.now(),dur:Math.max(300,dur)};playing=false}
sl.oninput=()=>{tw=null;playing=false;const v=sl.value/1000;pose(mode==='open'?1-v:v)};
act.onclick=()=>{if(mode==='build'){if(playing){playing=false}else{if(p>=.999)pose(0);playing=true}syncUI()}
 else if(mode==='open'){if(p<.01)tweenTo(1,2400);else{const t=STOPS[stepIdx()];tweenTo(t,Math.abs(p-t)*7000)}}};
document.querySelectorAll('#modes button').forEach(b=>b.onclick=()=>setMode(b.dataset.m));
function setMode(m){mode=m;playing=false;document.querySelectorAll('#modes button').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.m===m)));
 $('anim').classList.toggle('show',m!=='explore');
 if(m==='explore')tweenTo(1,1200);else if(m==='build')tweenTo(0,1200);else tweenTo(1,1200);
 flyTo(m==='build'?'Above':'3/4');syncUI()}

/* parts list + card */
const partsEl=$('parts');
GROUPS.forEach(gn=>{const h=document.createElement('h3');h.textContent=gn;partsEl.appendChild(h);
 Object.values(P).filter(x=>x.g===gn).forEach(x=>{const b=document.createElement('button');b.className='pi';b.textContent=x.name;b.dataset.id=x.id;b.onclick=()=>{pin(pinId===x.id?null:x.id,null)};partsEl.appendChild(b)})});
{const n=document.createElement('p');n.className='note';n.textContent='Tap a part to light it up and read about it.';partsEl.appendChild(n)}
$('partsBtn').onclick=()=>{const o=partsEl.classList.toggle('open');$('partsBtn').setAttribute('aria-expanded',String(o))};
const card=$('card'),tag=$('tag');
const esc=s=>String(s).replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));
function showCard(id,loc){
 if(!id){card.innerHTML='<div id="hintcard">Point at any part of the box or bottle, or tap it on a touch screen, to light it up and read what it is and why it is used. The Parts list does the same.</div>';return}
 const x=P[id];
 card.innerHTML=`<span class="chip">${esc(x.g)}</span><h2>${esc(x.name)}</h2><dl><div><dt>Material</dt><dd>${esc(x.material)}</dd></div><div><dt>What it is</dt><dd>${esc(x.what)}</dd></div><div><dt>Why it is used</dt><dd>${esc(x.why)}</dd></div>${loc?`<div><dt>Where</dt><dd>${esc(loc)}</dd></div>`:''}</dl>`}
let hoverId=null,pinId=null,shown=null,hoverLoc=null,pinLoc=null;
function refresh(){const id=hoverId||pinId;if(shown!==id){if(shown)setHL(shown,false);if(id)setHL(id,true);shown=id}
 showCard(id,hoverId?hoverLoc:pinLoc);
 partsEl.querySelectorAll('.pi').forEach(b=>b.classList.toggle('on',b.dataset.id===id))}
function pin(id,loc){pinId=id;pinLoc=loc||null;refresh()}
showCard(null);

/* picking, hover, tap, bottle spin */
const ray=new THREE.Raycaster(),ndc=new THREE.Vector2();
function cast(e,list){const r=dom.getBoundingClientRect();ndc.set((e.clientX-r.left)/r.width*2-1,-((e.clientY-r.top)/r.height)*2+1);ray.setFromCamera(ndc,camera);return ray.intersectObjects(list,false)}
function resolve(hits){for(const h of hits){const u=h.object.userData;const id=u.part||(u.slotParts&&u.slotParts[h.face.materialIndex]);if(id){let loc=u.loc;if(!loc&&bottleMeshes.includes(h.object))loc='Bottle';return{id,loc:loc||null}}}return null}
const canSpin=()=>p<.995;
let drag=null;
stage.addEventListener('pointerdown',e=>{
 drag={x:e.clientX,y:e.clientY,t:performance.now(),moved:0,spin:false,lastX:e.clientX};
 if(canSpin()&&cast(e,bottleMeshes).length){drag.spin=true;controls.enabled=false;spinVel=0;goal=null;try{stage.setPointerCapture(e.pointerId)}catch(_){}}
},true);
addEventListener('pointermove',e=>{
 if(drag){drag.moved=Math.max(drag.moved,Math.hypot(e.clientX-drag.x,e.clientY-drag.y));
  if(drag.spin){const dx=e.clientX-drag.lastX;drag.lastX=e.clientX;spin.rotation.y+=dx*.012;spinVel=dx*.012;inv()}return}
 if(e.pointerType!=='mouse'||e.target!==dom){if(e.target!==dom&&hoverId){hoverId=null;tag.style.display='none';refresh()}return}
 const r=resolve(cast(e,pick));
 if(r){tag.textContent=P[r.id].name;tag.style.display='block';tag.style.left=Math.min(e.clientX+14,innerWidth-170)+'px';tag.style.top=(e.clientY+16)+'px';
  const ch=hoverId!==r.id||hoverLoc!==r.loc;hoverId=r.id;hoverLoc=r.loc;if(ch)refresh()}
 else if(hoverId){hoverId=null;tag.style.display='none';refresh()}
 dom.style.cursor=canSpin()&&cast(e,bottleMeshes).length?'grab':'';
});
addEventListener('pointerup',e=>{if(!drag)return;const d=drag;drag=null;controls.enabled=true;
 if(d.moved<6&&(e.target===dom||d.spin)){const r=resolve(cast(e,pick));if(r)pin(pinId===r.id?null:r.id,r.loc);else pin(null)}});
dom.addEventListener('pointerleave',()=>{if(hoverId){hoverId=null;tag.style.display='none';refresh()}});

/* ---------- loop ---------- */
let last=performance.now();
(function loop(now){requestAnimationFrame(loop);const dt=Math.min(.1,(now-last)/1000);last=now;
 if(tw){const k=clamp((now-tw.t0)/tw.dur);pose(lerp(tw.from,tw.to,ease(k)));if(k>=1)tw=null}
 else if(playing){pose(p+dt/16);if(p>=1){playing=false;syncUI()}}
 if(goal){camera.position.lerp(goal.pos,.12);controls.target.lerp(goal.tg,.12);if(camera.position.distanceTo(goal.pos)<.05&&controls.target.distanceTo(goal.tg)<.05)goal=null;inv()}
 if(!drag&&Math.abs(spinVel)>.0004){spin.rotation.y+=spinVel;spinVel*=.94;inv()}
 if(controls.autoRotate)inv();
 if(controls.update())inv();
 if(dirty){dirty=false;renderer.render(scene,camera)}})(last);
pose(1);
window.__laksoy={pose,setMode,P};
}
})();
