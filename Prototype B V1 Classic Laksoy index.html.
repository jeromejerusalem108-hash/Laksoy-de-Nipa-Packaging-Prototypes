:root[data-theme="dark"]{--ink:#f3e7d0;--muted:#b9a88c;--panel:rgba(38,30,23,.93);--line:rgba(255,230,180,.18);--accent:#e3b24a;--accent-ink:#2a1a08;--chip:#4a3a28;--bg:#1b1510;color-scheme:dark}
