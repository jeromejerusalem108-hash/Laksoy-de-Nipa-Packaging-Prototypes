    // local +x of the right door points to world -z (back); of the left door to +z (front)
    const wall=R_?(sg>0?'B':'F'):(sg>0?'F':'B');
    const fg=new THREE.Group();fg.position.set(sg*W/2,0,0);ug.add(fg);P[name+'F'].push([fg,sg]);
    // u across the finished front/back wall: right door half is u in [.5,1] on the front, left half [0,.5]; mirrored on the back
