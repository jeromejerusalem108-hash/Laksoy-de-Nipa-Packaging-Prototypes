[['logo','Brand logo'],['name','Product name'],['slogan','Slogan / description'],['pattern','Nipa pattern'],['fruit','Nipa fruit'],['leaves','Nipa leaves'],['gold','Gold accents'],['stripe','Abaca stripe wrap'],['weave','Abaca weave'],['sleeve','Cover sleeve'],['walls','Door halves'],['lid','Lid halves / cork'],['lining','Black lining'],['board','Grey board'],['base','Base panel'],['inbd','Inside back board'],['glass','Glass bottle'],['label','Bottle label'],['crest','Neck crest'],['cork','Cork stopper'],['cap','Bottle cap']].forEach(([k,n])=>{
