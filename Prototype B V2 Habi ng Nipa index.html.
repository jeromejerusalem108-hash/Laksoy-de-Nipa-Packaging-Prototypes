function addReg(mesh,cls){reg.push(mesh);mesh.userData.cls=cls}
/* ---------- slab / hinge rig ---------- */
// A slab lives in a hinge group: hinge at group origin, panel extends +z (length h), spans x in [x0,x1].
// Outer face = -y (printed side faces DOWN when flat), lining = +y. Rotating -90deg about x folds it up with the outer face outward.
function slab(x0,x1,h,outerMat,innerMat,uvf,cls){
  const g=new THREE.BoxGeometry(x1-x0,T,h);g.translate((x0+x1)/2,T/2,h/2);
  const p=g.attributes.position,uv=g.attributes.uv;
  g.groups.forEach(gr=>{if(gr.materialIndex===2||gr.materialIndex===3){for(let i=gr.start;i<gr.start+gr.count;i++){const j=g.index.getX(i);const q=uvf(p.getX(j),p.getZ(j));uv.setXY(j,q[0],q[1])}}});
  const m=new THREE.Mesh(g,[M.edge,M.edge,innerMat,outerMat,M.edge,M.edge]);m.userData.cls=cls;
  // (the +x/-x/+z/-z box faces are the board edges)
  reg.push(m);return m}
function hinge(parent,x,y,z,ry){const g=new THREE.Group();g.position.set(x,y,z);g.rotation.order='YXZ';g.rotation.y=ry||0;parent.add(g);return g}
const am=k=>new THREE.MeshStandardMaterial({map:tex[k],roughness:.6,metalness:.05});
const sub=(k,u0,u1,v0,v1)=>{const t=tex[k].clone();t.needsUpdate=true;t.repeat.set(u1-u0,v1-v0);t.offset.set(u0,v0);return new THREE.MeshStandardMaterial({map:t,roughness:.6,metalness:.05})};
/* ---------- BOX rig ---------- */
const flat=new THREE.Group();scene.add(flat); // flat.rotation.z drives "flip sheet"
const boxRoot=new THREE.Group();flat.add(boxRoot);
const hf=W/2;
const P={}; // named hinges for animation
// base slab (W x W, centred)
const baseG=hinge(boxRoot,0,0,-hf,0);
const base=slab(-hf,hf,W,am('wv_base'),M.black,(x,z)=>[x/W+.5,z/W],'base');baseG.add(base);
function wallSide(dirRY,name,lowTex,upTex,sideFlag){
  // lower wall hinge at base edge; frame rotated by dirRY; local +z = away from base centre
  const lg=hinge(boxRoot,0,0,0,dirRY);const lowW=sideFlag?W-2*T:W;
  lg.position.set(Math.sin(dirRY)*hf,0,Math.cos(dirRY)*hf);
  const ls=slab(-lowW/2,lowW/2,LH,am(lowTex),M.black,(x,z)=>[x/lowW+.5,z/LH],'weave');lg.add(ls);
  P[name+'L']=lg;
  return lg}
// front (+z), back (-z), right(+x), left(-x); frame ry: front=0, back=PI, right=PI/2, left=-PI/2
const lf=wallSide(0,'F','wv'),lb=wallSide(Math.PI,'B','wv'),lr=wallSide(Math.PI/2,'R','wv',1),ll=wallSide(-Math.PI/2,'L','wv',1);
// DOORS: the top portion is cut down the middle of the FRONT and BACK. Each door = full side wall + half front + half back + half lid,
// one rigid piece hinged at the bottom side edge (y=3) and swinging outward.
function door(parent,name){
  const ug=new THREE.Group();ug.position.set(0,0,LH);parent.add(ug);P[name+'U']=ug;
  const R_=name==='R';
